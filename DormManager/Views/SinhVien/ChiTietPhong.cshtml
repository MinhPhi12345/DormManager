@using System.Data
@{
    ViewData["Title"] = "Chi tiết thông tin phòng";
    DataRow p = ViewBag.Phong;
    DataTable dsGiuong = ViewBag.DsGiuong;
    DataTable thanhVien = ViewBag.ThanhVien;
}

@* Chi tiết phòng | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .bed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: .7rem;
        }

        .bed-item {
            border: 2px solid #d8e2de;
            border-radius: .6rem;
            padding: .8rem .5rem;
            text-align: center;
            font-size: .85rem;
            background: #fff;
        }

            .bed-item .bi {
                font-size: 1.4rem;
                display: block;
                margin-bottom: .25rem;
            }

        .bed-trong {
            border-color: #0d5c4d;
        }

            .bed-trong .bi {
                color: #0d5c4d;
            }

        .bed-dasudung {
            background: #f4f4f4;
            color: #97a09b;
        }

        .bed-baotri {
            border-color: #f2a516;
        }

            .bed-baotri .bi {
                color: #f2a516;
            }

        .bed-item .btn {
            margin-top: .4rem;
        }
    </style>
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 fw-bold text-dm mb-3"><i class="bi bi-door-open me-2"></i>Phòng @p["MaPhong"]</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5">Tòa nhà</dt>
                    <dd class="col-7">@p["TenToa"] (@p["DiaChi"])</dd>
                    <dt class="col-5">Tầng</dt>
                    <dd class="col-7">@p["Tang"]</dd>
                    <dt class="col-5">Loại phòng</dt>
                    <dd class="col-7">@p["LoaiPhong"] giường</dd>
                    <dt class="col-5">Giường trống</dt>
                    <dd class="col-7">@p["SoGiuongTrong"] / @p["SoGiuong"]</dd>
                    <dt class="col-5">Giá phòng</dt>
                    <dd class="col-7 fw-bold text-dm">@(Convert.ToDecimal(p["GiaPhong"]).ToString("N0"))đ/người/tháng</dd>
                    <dt class="col-5">Tiện ích</dt>
                    <dd class="col-7">Điều hòa, tủ lạnh, máy giặt chung, wifi</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-white fw-semibold">Thành viên đang ở</div>
            <ul class="list-group list-group-flush">
                @if (thanhVien.Rows.Count == 0)
                {
                    <li class="list-group-item text-muted small">Chưa có sinh viên nào</li>
                }
                @foreach (DataRow tv in thanhVien.Rows)
                {
                    <li class="list-group-item small"><i class="bi bi-person me-2 text-dm"></i>@tv["HoTen"] - @tv["MSSV"] (@tv["KhoaHoc"])</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Sơ đồ giường - chọn giường trống để đăng ký</div>
            <div class="card-body">
                <div class="bed-grid">
                    @foreach (DataRow g in dsGiuong.Rows)
                    {
                        string tt = g["TrangThai"].ToString()!;
                        <div class="bed-item @(tt == "Trong" ? "bed-trong" : tt == "BaoTri" ? "bed-baotri" : "bed-dasudung")">
                            <i class="bi @(tt == "Trong" ? "bi-check-circle" : tt == "BaoTri" ? "bi-tools" : "bi-person-fill")"></i>
                            <div class="fw-semibold">@g["MaGiuong"]</div>
                            @if (tt == "Trong")
                            {
                                <a asp-action="DangKy" asp-route-maGiuong="@g["MaGiuong"]" class="btn btn-sm btn-dm">Đăng ký</a>
                            }
                            else
                            {
                                <div class="text-muted">@(tt == "BaoTri" ? "Bảo trì" : "Đã có người")</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <a asp-action="TraCuuPhong" class="btn btn-outline-secondary mt-3"><i class="bi bi-arrow-left me-1"></i>Quay lại tra cứu</a>
    </div>
</div>
