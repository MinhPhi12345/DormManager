@using System.Data
@{
    ViewData["Title"] = "Hợp đồng đăng ký";
    DataTable ds = ViewBag.DsHopDong;
}

@* Hợp đồng + Gia hạn + Trả phòng | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .contract-card {
            border-left: 4px solid #0d5c4d;
        }

            .contract-card.inactive {
                border-left-color: #b9c2bd;
                opacity: .8;
            }

        .contract-meta {
            font-size: .875rem;
            color: #5c6660;
        }
    </style>
}

@if (ds.Rows.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có hợp đồng nào. <a asp-action="TraCuuPhong" class="alert-link">Đăng ký ngay</a>.</div>
}

@foreach (DataRow r in ds.Rows)
{
    string tt = r["TrangThai"].ToString()!;
    bool dangO = tt == "DangO";
    <div class="card contract-card @(dangO || tt == "ChoDoiChieu" ? "" : "inactive") mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <h3 class="h6 fw-bold mb-1">
                        Hợp đồng #@r["MaPhieu"] - Phòng @r["MaPhong"] (@r["TenToa"]) - Giường @r["MaGiuong"]
                    </h3>
                    <div class="contract-meta">
                        @r["TenDot"] · @r["HocKy"] · Đăng ký ngày @(Convert.ToDateTime(r["NgayDangKy"]).ToString("dd/MM/yyyy"))
                    </div>
                    <div class="contract-meta">
                        Thời hạn: <b>@(Convert.ToDateTime(r["NgayBatDau"]).ToString("dd/MM/yyyy"))</b>
                        → <b>@(Convert.ToDateTime(r["NgayKetThuc"]).ToString("dd/MM/yyyy"))</b>
                        · Giá: @(Convert.ToDecimal(r["GiaPhong"]).ToString("N0"))đ/tháng
                    </div>
                </div>
                <div>
                    @switch (tt)
                    {
                        case "DangO":
                            <span class="badge text-bg-success">Đang ở</span>
                            ; break;
                        case "ChoDoiChieu":

                            <span class="badge text-bg-warning">Chờ đối chiếu</span>
                            ; break;
                        case "DaTraPhong":

                            <span class="badge text-bg-secondary">Đã trả phòng</span>
                            ; break;
                        default:

                            <span class="badge text-bg-danger">Đã hủy</span>
                            ; break;
                    }
                </div>
            </div>

            @if (dangO)
            {
                <hr class="my-2" />
                bool coDonTraPhongChoXL = r["MaDonTraPhongChoXL"] != DBNull.Value;
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <form method="post" asp-action="GiaHan" class="d-flex gap-2">
                        <input type="hidden" name="maPhieu" value="@r["MaPhieu"]" />
                        <select name="soThang" class="form-select form-select-sm" style="width:auto">
                            <option value="1">1 tháng</option>
                            <option value="2">2 tháng</option>
                            <option value="3">3 tháng</option>
                            <option value="5">5 tháng</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-dm"><i class="bi bi-arrow-repeat me-1"></i>Gia hạn lưu trú</button>
                    </form>
                    @if (coDonTraPhongChoXL)
                    {
                        <span class="badge text-bg-warning"><i class="bi bi-hourglass-split me-1"></i>Đang chờ Ban quản lý xác nhận trả phòng</span>
                    }
                    else
                    {
                        <form method="post" asp-action="TraPhong"
                              onsubmit="return confirm('Gửi yêu cầu trả phòng tới Ban quản lý? Bạn cần hoàn thành mọi nghĩa vụ tài chính trước khi được xác nhận.');">
                            <input type="hidden" name="maPhieu" value="@r["MaPhieu"]" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-left me-1"></i>Yêu cầu trả phòng</button>
                        </form>
                    }
                </div>
                @if (ViewBag.DoiTuong?.ToString() == "ChinhSach")
                {
 <div class="small text-muted mt-2"><i class="bi bi-star-fill text-warning me-1"></i>Bạn thuộc diện chính sách: được gia hạn bất kỳ lúc nào.</div>
                }
            }
        </div>
    </div>
}
