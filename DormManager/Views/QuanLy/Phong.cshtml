@using System.Data
@{
    ViewData["Title"] = "Danh sách phòng";
    DataTable ds = ViewBag.DsPhong;
    DataTable dsToa = ViewBag.DsToa;
    var q = Context.Request.Query;
}

@* Danh sách + tra cứu phòng | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .phong-table thead th {
            font-size: .78rem;
            text-transform: uppercase;
            color: #7a8580;
            background: #fafbfa;
        }

        .progress {
            height: 8px;
        }
    </style>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
 <label class="form-label small mb-1">Tra cứu phòng</label>
                <input type="text" name="tuKhoa" value="@q["tuKhoa"]" class="form-control" placeholder="Mã phòng..." />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Tòa nhà</label>
                <select name="maToa" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (DataRow t in dsToa.Rows)
                    {
                        <option value="@t["MaToa"]" selected="@(q["maToa"] == t["MaToa"].ToString())">@t["TenToa"]</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 phong-table">
            <thead>
                <tr><th>Mã phòng</th><th>Tòa / Tầng</th><th>Loại</th><th>Lấp đầy</th><th>Giá phòng</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (DataRow r in ds.Rows)
                {
                    int sg = Convert.ToInt32(r["SoGiuong"]);
                    int trong = Convert.ToInt32(r["SoGiuongTrong"]);
                    int dung = sg - trong;
                    <tr>
                        <td class="fw-semibold">@r["MaPhong"]</td>
                        <td>@r["TenToa"] · T@(r["Tang"])</td>
                        <td>@r["LoaiPhong"] giường</td>
                        <td style="min-width:130px">
                            <div class="small mb-1">@dung/@sg giường</div>
                            <div class="progress"><div class="progress-bar bg-success" style="width:@(sg == 0 ? 0 : dung * 100 / sg)%"></div></div>
                        </td>
                        <td>@(Convert.ToDecimal(r["GiaPhong"]).ToString("N0"))đ</td>
                        <td>
                            @switch (r["TrangThai"].ToString())
                            {
                                case "HoatDong":
                                    <span class="badge text-bg-success">Hoạt động</span>
                                    ; break;
                                case "BaoTri":

                                    <span class="badge text-bg-warning">Bảo trì</span>
                                    ; break;
                                default:

                                    <span class="badge text-bg-secondary">Ngừng sử dụng</span>
                                    ; break;
                            }
                        </td>
                        <td><a asp-action="Giuong" asp-route-maPhong="@r["MaPhong"]" class="btn btn-sm btn-outline-success"><i class="bi bi-grid-3x3-gap me-1"></i>Giường</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
