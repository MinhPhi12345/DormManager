@using System.Data
@{
    ViewData["Title"] = "Lịch sử hóa đơn";
    DataTable ds = ViewBag.DsHoaDon;
}

@* Lịch sử + tra cứu hóa đơn | View phức tạp -> style External *@
@section Styles {
    <link rel="stylesheet" href="~/css/views/hoadon.css" />
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Tháng (MM/yyyy)</label>
                <input type="text" name="thang" value="@Context.Request.Query["thang"]" class="form-control" placeholder="VD: 06/2026" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="ChoThanhToan" selected="@(Context.Request.Query["trangThai"] == "ChoThanhToan")">Chờ thanh toán</option>
                    <option value="QuaHan" selected="@(Context.Request.Query["trangThai"] == "QuaHan")">Quá hạn</option>
                    <option value="DaThanhToan" selected="@(Context.Request.Query["trangThai"] == "DaThanhToan")">Đã thanh toán</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    @if (ds.Rows.Count == 0)
    {
        <div class="col-12"><div class="alert alert-secondary">Không có hóa đơn nào.</div></div>
    }
    @foreach (DataRow h in ds.Rows)
    {
        string tt = h["TrangThai"].ToString()!;
        <div class="col-12 col-md-6 col-xl-4">
            <div class="hd-card card h-100 @(tt == "QuaHan" ? "hd-overdue" : tt == "DaThanhToan" ? "hd-paid" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="hd-month">Tháng @h["Thang"]</div>
                            <div class="hd-room"><i class="bi bi-door-open me-1"></i>Phòng @h["MaPhong"]</div>
                        </div>
                        @switch (tt)
                        {
                            case "ChoThanhToan":
                                <span class="badge text-bg-warning">Chờ thanh toán</span>
                                ; break;
                            case "QuaHan":

                                <span class="badge text-bg-danger">Quá hạn</span>
                                ; break;
                            default:

                                <span class="badge text-bg-success">Đã thanh toán</span>
                                ; break;
                        }
                    </div>
                    <div class="hd-total">@(Convert.ToDecimal(h["TongTien"]).ToString("N0"))<span>đ</span></div>
                    <div class="hd-due">
                        <i class="bi bi-calendar-event me-1"></i>Hạn thanh toán: @(Convert.ToDateTime(h["HanThanhToan"]).ToString("dd/MM/yyyy"))
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-action="ChiTietHoaDon" asp-route-id="@h["MaHD"]"
                       class="btn w-100 @(tt == "DaThanhToan" ? "btn-outline-secondary" : "btn-dm")">
                        @(tt == "DaThanhToan" ? "Xem chi tiết" : "Chi tiết & thanh toán")
                    </a>
                </div>
            </div>
        </div>
    }

</div>
