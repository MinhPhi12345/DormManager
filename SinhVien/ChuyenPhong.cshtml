@using System.Data
@{
    ViewData["Title"] = "Đăng ký chuyển phòng";
    DataRow pd = ViewBag.Phieu;
    DataTable ds = ViewBag.DsGiuong;
}

@* Chọn giường muốn chuyển đến | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .cp-current {
            background: #eef5f2;
            border-radius: .6rem;
            padding: .9rem 1.2rem;
        }

        .cp-table thead th {
            font-size: .78rem;
            text-transform: uppercase;
            color: #7a8580;
            background: #fafbfa;
        }
    </style>
}

<div class="cp-current small mb-3">
    <i class="bi bi-house-door me-1 text-dm"></i>
    Đang ở phòng <b>@pd["MaPhong"]</b> - Loại phòng @pd["LoaiPhong"] giường.
    Chọn một giường trống ở phòng khác bên dưới để gửi yêu cầu chuyển phòng tới Ban quản lý.
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 cp-table">
            <thead>
                <tr><th>Tòa</th><th>Phòng</th><th>Tầng</th><th>Loại phòng</th><th>Giá</th><th>Giường</th><th></th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Hiện không có giường trống phù hợp để chuyển đến.</td></tr>
                }
                @foreach (DataRow g in ds.Rows)
                {
                    <tr>
                        <td>@g["TenToa"]</td>
                        <td class="fw-semibold">@g["MaPhong"]</td>
                        <td>@g["Tang"]</td>
                        <td>@g["LoaiPhong"] giường</td>
                        <td>@(Convert.ToDecimal(g["GiaPhong"]).ToString("N0"))đ/tháng</td>
                        <td>@g["MaGiuong"]</td>
                        <td>
                            <form method="post" asp-action="GuiDonChuyenPhong"
                                  data-confirm-title="Xác nhận gửi yêu cầu chuyển phòng"
                                  data-confirm-level="warning"
                                  data-confirm-message="Gửi yêu cầu chuyển sang phòng @g["MaPhong"] (giường @g["MaGiuong"])? Yêu cầu cần Ban quản lý xác nhận mới có hiệu lực.">
                                <input type="hidden" name="maPhieu" value="@pd["MaPhieu"]" />
                                <input type="hidden" name="maGiuongMoi" value="@g["MaGiuong"]" />
                                <button type="submit" class="btn btn-sm btn-dm"><i class="bi bi-arrow-left-right me-1"></i>Chuyển đến đây</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a asp-action="HopDong" class="btn btn-outline-secondary mt-3"><i class="bi bi-arrow-left me-1"></i>Quay lại hợp đồng</a>
