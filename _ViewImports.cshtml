/* ===== BM34 - Nhập chỉ số điện nước (External CSS) ===== */
.cs-card { border-top: 4px solid #f2a516; }
.cs-card.cs-done { border-top-color: #198754; }
.cs-card.cs-locked { border-top-color: #97a09b; opacity: .88; }

.cs-head {
    display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
    padding: .8rem 1rem .2rem;
}
.cs-room { font-weight: 700; font-size: 1.02rem; }
.cs-people { color: #6c757d; margin-right: auto; }

.cs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
.cs-meter-label { font-size: .82rem; font-weight: 600; margin-bottom: .35rem; }
.cs-pair { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
.cs-pair label { font-size: .7rem; color: #8a938e; margin-bottom: .1rem; }

@media (max-width: 575.98px) {
    .cs-grid { grid-template-columns: 1fr; }
}
