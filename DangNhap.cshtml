/* ===== BM03 - Thông tin tổng quan (External CSS) ===== */
.tq-stat {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: .5rem;
    transition: transform .15s ease, box-shadow .15s ease;
}
.tq-stat:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(20,40,35,.14); }
.tq-stat-icon {
    width: 48px; height: 48px; border-radius: .8rem; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 1.35rem; color: #fff;
}
.tq-stat-icon.bg-room  { background: #0d5c4d; }
.tq-stat-icon.bg-floor { background: #2a7f8f; }
.tq-stat-icon.bg-money { background: #f2a516; }
.tq-stat-icon.bg-date  { background: #7161ba; }
.tq-stat-value { font-size: 1.15rem; font-weight: 700; line-height: 1.2; }
.tq-stat-label { font-size: .8rem; color: #6c757d; }

.tq-card-header {
    background: #fff; font-weight: 600;
    border-bottom: 2px solid #e8ecea;
}
.tq-table thead th {
    font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
    color: #7a8580; background: #fafbfa;
}

@media (max-width: 575.98px) {
    .tq-stat-value { font-size: 1rem; }
}
