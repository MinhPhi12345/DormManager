@{
    string loai = ViewBag.Loai;
    ViewData["Title"] = loai == "PhanHoi" ? "Tạo đơn phản hồi" : "Tạo đơn đề xuất";
}

@* Tạo đơn phản hồi / đề xuất | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .form-box {
            max-width: 640px;
        }
    </style>
}

<div class="form-box card p-4">
    <h2 class="h5 fw-bold text-dm mb-3">
        <i class="bi @(loai == "PhanHoi" ? "bi-chat-left-dots" : "bi-lightbulb") me-2"></i>@ViewData["Title"]
    </h2>
    <p class="text-muted small">
        @(loai == "PhanHoi"
                ? "Gửi yêu cầu sửa chữa cơ sở vật chất (hỏng điện, nước, internet...) hoặc phản hồi về chất lượng dịch vụ của phòng đang ở."
                : "Đề xuất ban quản lý trang bị thêm đồ dùng tiện ích cho phòng (ví dụ: lắp thêm quạt, thay rèm). Điền tên thiết bị và lý do đề xuất.")
    </p>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger py-2 small">@ViewBag.Loi</div>
    }

    <form method="post" asp-action="TaoDon">
        <input type="hidden" name="loai" value="@loai" />
        <div class="mb-3">
            <label class="form-label">@(loai == "PhanHoi" ? "Tiêu đề sự cố" : "Tên thiết bị đề xuất")</label>
            <input type="text" name="tieuDe" class="form-control" required maxlength="200" />
        </div>
        <div class="mb-4">
            <label class="form-label">@(loai == "PhanHoi" ? "Mô tả chi tiết" : "Lý do đề xuất")</label>
            <textarea name="noiDung" class="form-control" rows="5" required></textarea>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="DonYeuCau" asp-route-loai="@loai" class="btn btn-outline-secondary w-50">Trở về</a>
            <button type="submit" class="btn btn-dm w-50">Gửi đơn</button>
        </div>
    </form>
</div>
