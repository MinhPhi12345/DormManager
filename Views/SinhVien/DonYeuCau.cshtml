@using System.Data
@{
    string loai = ViewBag.Loai;
    ViewData["Title"] = loai == "PhanHoi" ? "Lịch sử đơn phản hồi" : "Lịch sử đơn đề xuất";
    DataTable ds = ViewBag.DsDon;
}

@* Lịch sử đơn phản hồi / đề xuất | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .don-tabs .nav-link {
            color: #5c6660;
        }

            .don-tabs .nav-link.active {
                background: #0d5c4d;
                color: #fff;
            }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <ul class="nav nav-pills don-tabs">
        <li class="nav-item"><a class="nav-link @(loai == "PhanHoi" ? "active" : "")" asp-action="DonYeuCau" asp-route-loai="PhanHoi">Đơn phản hồi</a></li>
        <li class="nav-item"><a class="nav-link @(loai == "DeXuat" ? "active" : "")" asp-action="DonYeuCau" asp-route-loai="DeXuat">Đơn đề xuất</a></li>
    </ul>
    <a asp-action="TaoDon" asp-route-loai="@loai" class="btn btn-dm">
        <i class="bi bi-plus-lg me-1"></i>@(loai == "PhanHoi" ? "Tạo đơn phản hồi" : "Tạo đơn đề xuất")
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Tiêu đề</th><th>Mức ưu tiên</th><th>Ngày tạo</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn nào</td></tr>
                }
                @for (int i = 0; i < ds.Rows.Count; i++)
                {
                    var d = ds.Rows[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@d["TieuDe"]</td>
                        <td>
                            @switch (d["MucUuTien"].ToString())
                            {
                                case "Cao":
                                    <span class="badge text-bg-danger">Cao</span>
                                    ; break;
                                case "TrungBinh":

                                    <span class="badge text-bg-warning">Trung bình</span>
                                    ; break;
                                default:

                                    <span class="badge text-bg-secondary">Thấp</span>
                                    ; break;
                            }
                        </td>
                        <td>@(Convert.ToDateTime(d["NgayTao"]).ToString("dd/MM/yyyy HH:mm"))</td>
                        <td>
                            @switch (d["TrangThai"].ToString())
                            {
                                case "ChoXuLy":
                                    <span class="badge text-bg-secondary">Chờ xử lý</span>
                                    ; break;
                                case "DangXuLy":

                                    <span class="badge text-bg-info">Đang xử lý</span>
                                    ; break;
                                case "DaXuLy":

                                    <span class="badge text-bg-success">Đã xử lý</span>
                                    ; break;
                                default:

                                    <span class="badge text-bg-danger">Từ chối</span>
                                    ; break;
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="ChiTietDon" asp-route-id="@d["MaDon"]" class="btn btn-sm btn-outline-success">Chi tiết</a>
                                @* Chỉ hiện nút Xóa nếu đơn đang ở trạng thái Chờ xử lý *@
                                @if (d["TrangThai"].ToString() == "ChoXuLy")
                                {
                                    <form method="post" asp-action="XoaDon" class="d-inline"
                                          data-confirm-title="Xóa đơn yêu cầu" data-confirm-level="danger"
                                          data-confirm-message="Bạn có chắc chắn muốn hủy và xóa đơn này không?">
                                        <input type="hidden" name="maDon" value="@d["MaDon"]" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đơn"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>