@{
    ViewData["Title"] = "Không có quyền truy cập";
}

@* View đơn giản -> style Inline *@
@section Styles {
    <style>
        .deny-box {
            max-width: 480px;
            margin: 8vh auto;
            text-align: center;
        }

            .deny-box .bi {
                font-size: 4rem;
                color: #dc3545;
            }
    </style>
}

<div class="deny-box card p-4">
    <i class="bi bi-shield-lock"></i>
    <h2 class="h5 mt-3">Bạn không có quyền truy cập chức năng này</h2>
    <p class="text-muted">Vui lòng quay lại trang chính hoặc đăng nhập bằng tài khoản phù hợp.</p>
    <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-dm">Về trang đăng nhập</a>
</div>
