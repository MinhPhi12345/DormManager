@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LayoutAuth";
}

@* Đăng nhập | View đơn giản -> style Inline *@
@section Styles {
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #084237 0%, #0d5c4d 55%, #12735f 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 410px;
            background: #fff;
            border-radius: 1rem;
            box-shadow: 0 18px 45px rgba(0,0,0,.28);
            padding: 2.2rem 2rem;
            margin: 1rem;
        }

        .login-logo {
            width: 62px;
            height: 62px;
            border-radius: 1rem;
            background: #0d5c4d;
            color: #f2a516;
            font-size: 1.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto .8rem;
        }

        .btn-login {
            background: #0d5c4d;
            color: #fff;
            font-weight: 600;
        }

            .btn-login:hover {
                background: #084237;
                color: #fff;
            }
    </style>
}

<div class="login-card">
    <div class="login-logo"><i class="bi bi-buildings-fill"></i></div>
    <h1 class="h4 text-center fw-bold mb-1">DormManager</h1>
    <p class="text-center text-muted small mb-4">Hệ thống quản lý Ký túc xá &amp; Hóa đơn điện nước</p>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Loi</div>
    }

    <form method="post" asp-action="DangNhap">
        <div class="mb-3">
            <label class="form-label">Email / Tên đăng nhập</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" name="tenDangNhap" class="form-control" placeholder="VD: 24DH113343" required autofocus />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label">Mật khẩu</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" name="matKhau" class="form-control" placeholder="••••••" required />
            </div>
        </div>
        <div class="text-end mb-3">
            <a asp-action="QuenMatKhau" class="small text-decoration-none">Quên mật khẩu?</a>
        </div>
        <button type="submit" class="btn btn-login w-100 py-2">Đăng nhập</button>
    </form>
</div>
