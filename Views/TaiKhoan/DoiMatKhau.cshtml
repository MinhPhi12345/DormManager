@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@* View Đổi mật khẩu | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .form-box {
            max-width: 480px;
        }
    </style>
}

<div class="form-box card p-4 mx-auto mt-4">
    <h2 class="h5 fw-bold text-dm mb-3">
        <i class="bi bi-key me-2"></i>Thay đổi mật khẩu
    </h2>
    <p class="text-muted small mb-4">
        Vui lòng nhập mật khẩu hiện tại và mật khẩu mới của bạn. Mật khẩu mới cần có ít nhất 6 ký tự.
    </p>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-circle me-1"></i>@ViewBag.Loi</div>
    }

    <form method="post" asp-action="DoiMatKhau">
        <div class="mb-3">
            <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
            <input type="password" name="matKhauCu" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Mật khẩu mới</label>
            <input type="password" name="matKhauMoi" class="form-control" required minlength="6" />
        </div>
        <div class="mb-4">
            <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
            <input type="password" name="xacNhanMatKhau" class="form-control" required minlength="6" />
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-dm px-4"><i class="bi bi-save me-1"></i>Đổi mật khẩu</button>
        </div>
    </form>
</div>