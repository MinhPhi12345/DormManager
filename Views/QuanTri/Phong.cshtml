@using System.Data
@{
    ViewData["Title"] = "Quản lý phòng (QTV)";
    DataTable ds = ViewBag.DsPhong;
    DataTable dsToa = ViewBag.DsToa;
    var q = Context.Request.Query;
}

@* Danh sách, tra cứu, thêm, sửa, xóa phòng | View phức tạp -> style External *@
@section Styles {
    <link rel="stylesheet" href="~/css/views/phong-admin.css" />
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
 <label class="form-label small mb-1">Tra cứu</label>
                <input type="text" name="tuKhoa" value="@q["tuKhoa"]" class="form-control" placeholder="Mã phòng..." />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-1">Tòa nhà</label>
                <select name="maToa" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (DataRow t in dsToa.Rows)
                    {
                        <option value="@t["MaToa"]" selected="@(q["maToa"] == t["MaToa"].ToString())">@t["TenToa"]</option>
                    }
                </select>
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="HoatDong" selected="@(q["trangThai"] == "HoatDong")">Hoạt động</option>
                    <option value="BaoTri" selected="@(q["trangThai"] == "BaoTri")">Bảo trì</option>
                    <option value="NgungSuDung" selected="@(q["trangThai"] == "NgungSuDung")">Ngừng sử dụng</option>
                </select>
            </div>
            <div class="col-4 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
            <div class="col-12 col-md-2 text-md-end">
                <button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#modalThem">
                    <i class="bi bi-plus-lg me-1"></i>Thêm phòng
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pa-table">
            <thead>
                <tr><th>Mã phòng</th><th>Tòa / Tầng</th><th>Loại</th><th class="text-center">SV ở</th><th class="text-end">Giá phòng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có phòng nào</td></tr>
                }
                @foreach (DataRow r in ds.Rows)
                {
                    int soSV = Convert.ToInt32(r["SoSVO"]);
                    <tr>
                        <td class="fw-semibold">@r["MaPhong"]</td>
                        <td>@r["TenToa"] · T@(r["Tang"])</td>
                        <td>@r["LoaiPhong"] giường</td>
                        <td class="text-center">@soSV/@r["SoGiuong"]</td>
                        <td class="text-end">@(Convert.ToDecimal(r["GiaPhong"]).ToString("N0"))đ</td>
                        <td>
                            @switch (r["TrangThai"].ToString())
                            {
                                case "HoatDong":
                                    <span class="badge text-bg-success">Hoạt động</span>
                                    ; break;
                                case "BaoTri":
                                    <span class="badge text-bg-warning">Bảo trì</span>
                                    ; break;
                                default:
                                    <span class="badge text-bg-secondary">Ngừng sử dụng</span>
                                    ; break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="AnhPhong" asp-route-maPhong="@r["MaPhong"]" class="btn btn-sm btn-outline-primary" title="Quản lý ảnh phòng">
                                <i class="bi bi-images"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-success"
                                    data-bs-toggle="modal" data-bs-target="#modalSua"
                                    data-phong="@r["MaPhong"]" data-gia="@Convert.ToDecimal(r["GiaPhong"])" data-tt="@r["TrangThai"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form method="post" asp-action="XoaPhong" class="d-inline"
                                  data-confirm-title="Xóa phòng" data-confirm-level="danger"
                                  data-confirm-message="Xóa phòng @r["MaPhong"]? Phòng có dữ liệu lịch sử sẽ chuyển sang Ngừng sử dụng.">
                                <input type="hidden" name="maPhong" value="@r["MaPhong"]" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" @(soSV > 0 ? "disabled" : "")><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===== Modal thêm phòng ===== *@
<div class="modal fade" id="modalThem" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="ThemPhong" class="modal-content">
            <div class="modal-header pa-modal-head">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm phòng mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Tòa nhà</label>
                    <select name="maToa" id="themToa" class="form-select" required>
                        @foreach (DataRow t in dsToa.Rows)
                        {
                            <option value="@t["MaToa"]" data-sotang="@t["SoTang"]">@t["TenToa"] (@t["SoTang"] tầng)</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Tầng</label>
                        <input type="number" name="tang" id="themTang" class="form-control" min="1" value="1" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Loại phòng</label>
                        <select name="loaiPhong" class="form-select">
                            <option value="4">4 giường</option>
                            <option value="6" selected>6 giường</option>
                            <option value="8">8 giường</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Giá phòng (đ/người/tháng)</label>
                    <input type="number" name="giaPhong" class="form-control" min="0" step="10000" value="450000" required />
                </div>
                <div class="small text-muted">Mã phòng và danh sách giường được hệ thống sinh tự động.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-dm">Thêm phòng</button>
            </div>
        </form>
    </div>
</div>

@* ===== Modal cập nhật phòng ===== *@
<div class="modal fade" id="modalSua" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="CapNhatPhong" class="modal-content">
            <div class="modal-header pa-modal-head">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Cập nhật phòng <span id="suaTen"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="maPhong" id="suaMa" />
                <div class="mb-3">
                    <label class="form-label">Giá phòng (đ/người/tháng)</label>
                    <input type="number" name="giaPhong" id="suaGia" class="form-control" min="0" step="10000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="trangThai" id="suaTT" class="form-select">
                        <option value="HoatDong">Hoạt động</option>
                        <option value="BaoTri">Bảo trì</option>
                        <option value="NgungSuDung">Ngừng sử dụng</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-dm">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Đổ dữ liệu dòng được chọn vào modal cập nhật
        document.getElementById('modalSua').addEventListener('show.bs.modal', function (ev) {
            const btn = ev.relatedTarget;
            document.getElementById('suaMa').value = btn.dataset.phong;
            document.getElementById('suaTen').textContent = btn.dataset.phong;
            document.getElementById('suaGia').value = btn.dataset.gia;
            document.getElementById('suaTT').value = btn.dataset.tt;
        });
        // Giới hạn tầng theo số tầng của tòa được chọn
        const themToa = document.getElementById('themToa');
        const themTang = document.getElementById('themTang');
        function capNhatMaxTang() {
            themTang.max = themToa.selectedOptions[0].dataset.sotang;
            if (+themTang.value > +themTang.max) themTang.value = themTang.max;
        }
        themToa.addEventListener('change', capNhatMaxTang);
        capNhatMaxTang();
    </script>
}
