@using System.Data
@{
    ViewData["Title"] = "Quản lý tài khoản";
    DataTable ds = ViewBag.DsTK;
    DataTable dsToa = ViewBag.DsToa;
    var q = Context.Request.Query;
}

@* Danh sách, tra cứu, tạo, cập nhật, xóa tài khoản | View phức tạp -> style External *@
@section Styles {
    <link rel="stylesheet" href="~/css/views/taikhoan-admin.css" />
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Tra cứu</label>
                <input type="text" name="tuKhoa" value="@q["tuKhoa"]" class="form-control" placeholder="Tên đăng nhập, email, họ tên..." />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-1">Vai trò</label>
                <select name="vaiTro" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="SV" selected="@(q["vaiTro"] == "SV")">Sinh viên</option>
                    <option value="QL" selected="@(q["vaiTro"] == "QL")">Quản lý</option>
                    <option value="QTV" selected="@(q["vaiTro"] == "QTV")">Quản trị viên</option>
                </select>
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="HoatDong" selected="@(q["trangThai"] == "HoatDong")">Hoạt động</option>
                    <option value="BiKhoa" selected="@(q["trangThai"] == "BiKhoa")">Bị khóa</option>
                </select>
            </div>
            <div class="col-4 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
            <div class="col-12 col-md-2 text-md-end">
                <button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#modalTaoTK">
                    <i class="bi bi-person-plus me-1"></i>Tạo tài khoản
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tka-table">
            <thead>
                <tr><th>#</th><th>Tên đăng nhập</th><th>Họ tên</th><th>Email / SĐT</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có tài khoản nào</td></tr>
                }
                @foreach (DataRow r in ds.Rows)
                {
                    <tr>
                        <td>@r["MaTK"]</td>
                        <td class="fw-semibold">@r["TenDangNhap"]</td>
                        <td>@r["HoTen"]</td>
                        <td class="small">@r["Email"]<div class="text-muted">@r["SDT"]</div></td>
                        <td>
                            @switch (r["VaiTro"].ToString())
                            {
                                case "SV":
                                    <span class="badge tka-badge-sv">Sinh viên</span>
                                    ; break;
                                case "QL":

                                    <span class="badge tka-badge-ql">Quản lý</span>
                                    ; break;
                                default:

                                    <span class="badge tka-badge-qtv">Quản trị viên</span>
                                    ; break;
                            }
                        </td>
                        <td>
                            @if (r["TrangThai"].ToString() == "HoatDong")
                            {
                                <span class="badge text-bg-success">Hoạt động</span>
                            }
                            else
                            {

                                <span class="badge text-bg-danger">Bị khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-success"
                                    data-bs-toggle="modal" data-bs-target="#modalSuaTK"
                                    data-matk="@r["MaTK"]" data-ten="@r["TenDangNhap"]" data-vaitro="@r["VaiTro"]"
                                    data-email="@r["Email"]" data-sdt="@r["SDT"]" data-tt="@r["TrangThai"]"
                                    data-hoten="@r["HoTen"]"
                                    data-khoahoc="@(r["KhoaHoc"] == DBNull.Value ? "" : r["KhoaHoc"])"
                                    data-doituong="@(r["DoiTuong"] == DBNull.Value ? "BinhThuong" : r["DoiTuong"])"
                                    data-matoa="@(r["MaToa"] == DBNull.Value ? "" : r["MaToa"])">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (r["VaiTro"].ToString() != "QTV")
                            {
                                <form method="post" asp-action="XoaTaiKhoan" class="d-inline"
                                      onsubmit="return confirm('Xóa tài khoản @r["TenDangNhap"]? Tài khoản có dữ liệu ràng buộc sẽ bị khóa thay vì xóa.');">
                                    <input type="hidden" name="maTK" value="@r["MaTK"]" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===== Modal tạo tài khoản ===== *@
<div class="modal fade" id="modalTaoTK" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="TaoTaiKhoan" class="modal-content">
            <div class="modal-header tka-modal-head">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Tạo tài khoản mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Vai trò</label>
                    <select name="vaiTro" id="taoVaiTro" class="form-select">
                        <option value="SV">Sinh viên</option>
                        <option value="QL">Quản lý</option>
                        <option value="QTV">Quản trị viên</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" name="tenDangNhap" class="form-control" placeholder="VD: 24DH113348" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Mật khẩu</label>
                        <input type="password" name="matKhau" class="form-control" required minlength="6" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="col-5">
                        <label class="form-label">SĐT</label>
                        <input type="text" name="sdt" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" name="hoTen" class="form-control" required />
                </div>
                <div class="row g-2 mb-2 khoi-sv">
                    <div class="col-6">
                        <label class="form-label">Khóa học</label>
                        <input type="text" name="khoaHoc" class="form-control" placeholder="K2026" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Đối tượng</label>
                        <select name="doiTuong" class="form-select">
                            <option value="BinhThuong">Bình thường</option>
                            <option value="ChinhSach">Diện chính sách</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2 khoi-ql" style="display:none">
                    <label class="form-label">Tòa nhà phụ trách</label>
                    <select name="maToa" class="form-select">
                        <option value="">— Chưa phân công —</option>
                        @foreach (DataRow t in dsToa.Rows)
                        {
                            <option value="@t["MaToa"]">@t["TenToa"]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-dm">Tạo tài khoản</button>
            </div>
        </form>
    </div>
</div>

@* ===== Modal cập nhật tài khoản ===== *@
<div class="modal fade" id="modalSuaTK" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="CapNhatTaiKhoan" class="modal-content">
            <div class="modal-header tka-modal-head">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Cập nhật tài khoản <span id="suaTKTen"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="maTK" id="suaTKMa" />
                <input type="hidden" name="vaiTro" id="suaTKVaiTro" />

                <div class="mb-3">
                    <label class="form-label">Vai trò</label>
                    <input type="text" id="suaTKVaiTroHienThi" class="form-control" disabled />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" id="suaTKTenDangNhap" class="form-control" disabled />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="matKhauMoi" class="form-control" minlength="6" placeholder="Bỏ trống nếu giữ nguyên" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" id="suaTKEmail" class="form-control" required />
                    </div>
                    <div class="col-5">
                        <label class="form-label">SĐT</label>
                        <input type="text" name="sdt" id="suaTKSdt" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" name="hoTen" id="suaTKHoTen" class="form-control" required />
                </div>
                <div class="row g-2 mb-2 sua-khoi-sv">
                    <div class="col-6">
                        <label class="form-label">Khóa học</label>
                        <input type="text" name="khoaHoc" id="suaTKKhoaHoc" class="form-control" placeholder="K2026" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Đối tượng</label>
                        <select name="doiTuong" id="suaTKDoiTuong" class="form-select">
                            <option value="BinhThuong">Bình thường</option>
                            <option value="ChinhSach">Diện chính sách</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2 sua-khoi-ql">
                    <label class="form-label">Tòa nhà phụ trách</label>
                    <select name="maToa" id="suaTKMaToa" class="form-select">
                        <option value="">— Chưa phân công —</option>
                        @foreach (DataRow t in dsToa.Rows)
                        {
                            <option value="@t["MaToa"]">@t["TenToa"]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-dm">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Hiện/ẩn field theo vai trò khi tạo tài khoản
        const taoVaiTro = document.getElementById('taoVaiTro');
        function toggleKhoi() {
            document.querySelectorAll('.khoi-sv').forEach(e => e.style.display = taoVaiTro.value === 'SV' ? '' : 'none');
            document.querySelectorAll('.khoi-ql').forEach(e => e.style.display = taoVaiTro.value === 'QL' ? '' : 'none');
        }
        taoVaiTro.addEventListener('change', toggleKhoi);
        toggleKhoi();

        // Đổ dữ liệu vào modal cập nhật + ẩn/hiện field theo vai trò
        document.getElementById('modalSuaTK').addEventListener('show.bs.modal', function (ev) {
            const b = ev.relatedTarget;
            const vaiTro = b.dataset.vaitro;

            document.getElementById('suaTKMa').value = b.dataset.matk;
            document.getElementById('suaTKVaiTro').value = vaiTro;
            document.getElementById('suaTKTen').textContent = b.dataset.ten;
            document.getElementById('suaTKTenDangNhap').value = b.dataset.ten;
            document.getElementById('suaTKVaiTroHienThi').value =
                vaiTro === 'SV' ? 'Sinh viên' : vaiTro === 'QL' ? 'Quản lý' : 'Quản trị viên';
            document.getElementById('suaTKEmail').value = b.dataset.email;
            document.getElementById('suaTKSdt').value = b.dataset.sdt;
            document.getElementById('suaTKHoTen').value = b.dataset.hoten;
            document.getElementById('suaTKKhoaHoc').value = b.dataset.khoahoc || '';
            document.getElementById('suaTKDoiTuong').value = b.dataset.doituong || 'BinhThuong';
            document.getElementById('suaTKMaToa').value = b.dataset.matoa || '';

            document.querySelectorAll('.sua-khoi-sv').forEach(e => e.style.display = vaiTro === 'SV' ? '' : 'none');
            document.querySelectorAll('.sua-khoi-ql').forEach(e => e.style.display = vaiTro === 'QL' ? '' : 'none');
        });
    </script>
}
