@using System.Data
@using DormManager.Helpers
@{
    ViewData["Title"] = "Nhật ký thao tác hệ thống";
    DataTable ds = ViewBag.DsNhatKy;
    DataTable doiTuongList = ViewBag.DsDoiTuong;
    var q = Context.Request.Query;
    var pager = (PagerViewModel)ViewBag.Pager;
    int soThuTuBatDau = (pager.Trang - 1) * PagingHelper.KichThuocTrangMacDinh;
}

@* Nhật ký hệ thống | View phức tạp -> style External *@
@section Styles {
    <link rel="stylesheet" href="~/css/views/nhatky.css" />
}

<div class="alert alert-light border small mb-3">
    <i class="bi bi-info-circle me-1 text-dm"></i>
    Ghi lại toàn bộ thao tác Thêm/Sửa/Xóa/Khóa/Mở khóa của Quản trị viên đối với Phòng, Tài khoản, Đợt đăng ký, Đơn giá điện/nước... để truy vết khi cần.
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Hành động</label>
                <select name="hanhDong" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Them" selected="@(q["hanhDong"] == "Them")">Thêm</option>
                    <option value="Sua" selected="@(q["hanhDong"] == "Sua")">Sửa</option>
                    <option value="Xoa" selected="@(q["hanhDong"] == "Xoa")">Xóa</option>
                    <option value="Khoa" selected="@(q["hanhDong"] == "Khoa")">Khóa</option>
                    <option value="MoKhoa" selected="@(q["hanhDong"] == "MoKhoa")">Mở khóa</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Đối tượng</label>
                <select name="doiTuong" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (DataRow d in doiTuongList.Rows)
                    {
                        <option value="@d["DoiTuong"]" selected="@(q["doiTuong"] == d["DoiTuong"].ToString())">@d["DoiTuong"]</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Từ ngày</label>
                <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Đến ngày</label>
                <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Lọc</button>
            </div>
        </form>
        <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Mặc định chỉ hiện 30 ngày gần nhất - xóa 2 ô ngày để xem tất cả (kết quả sẽ hiển thị theo trang).</div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 nk-table">
            <thead>
                <tr><th>#</th><th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th><th>Nội dung</th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có nhật ký nào</td></tr>
                }
                @for (int i = 0; i < ds.Rows.Count; i++)
                {
                    var r = ds.Rows[i];
                    <tr>
                        <td>@(soThuTuBatDau + i + 1)</td>
                        <td class="text-nowrap">@(Convert.ToDateTime(r["ThoiGian"]).ToString("HH:mm dd/MM/yyyy"))</td>
                        <td>@r["HoTenNguoiThucHien"] <span class="text-muted small">(@r["VaiTro"])</span></td>
                        <td>
                            @switch (r["HanhDong"].ToString())
                            {
                                case "Them":
                                    <span class="badge text-bg-success">Thêm</span>
                                    ; break;
                                case "Sua":
                                    <span class="badge text-bg-warning">Sửa</span>
                                    ; break;
                                case "Khoa":
                                    <span class="badge text-bg-secondary"><i class="bi bi-lock-fill me-1"></i>Khóa</span>
                                    ; break;
                                case "MoKhoa":
                                    <span class="badge text-bg-info"><i class="bi bi-unlock-fill me-1"></i>Mở khóa</span>
                                    ; break;
                                default:
                                    <span class="badge text-bg-danger">Xóa</span>
                                    ; break;
                            }
                        </td>
                        <td>@r["DoiTuong"]</td>
                        <td class="small">@r["NoiDung"]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-3 pb-3">
        @await Html.PartialAsync("_Pager", pager)
    </div>
</div>
