@using System.Data
@{
    ViewData["Title"] = "Xử lý đơn phản hồi, yêu cầu";
    DataRow d = ViewBag.Don;
    string loaiDon = d["LoaiDon"].ToString()!;
    string trangThai = d["TrangThai"].ToString()!;
    // Đơn chuyển/trả phòng đã "Đã xử lý" nghĩa là giường/hợp đồng đã được thay đổi THẬT SỰ
    // (không thể hoàn tác bằng cách đổi lại trạng thái) -> khóa hẳn form Xử lý đơn chung,
    // tránh trường hợp quản lý vô tình đổi trạng thái về Chờ/Đang xử lý rồi bấm "Xác nhận" lại lần nữa.
    bool khoaVinhVien = (loaiDon == "TraPhong" || loaiDon == "ChuyenPhong") && trangThai == "DaXuLy";
}

@* Sắp xếp ưu tiên + xử lý đơn | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .don-content {
            background: #f6f8f7;
            border-radius: .6rem;
            padding: 1rem 1.2rem;
            white-space: pre-wrap;
        }
    </style>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card p-4">
            <h2 class="h5 fw-bold mb-1">@d["TieuDe"]</h2>
            <div class="text-muted small mb-3">
                @(d["LoaiDon"].ToString() == "PhanHoi" ? "Đơn phản hồi" : "Đơn đề xuất") #@d["MaDon"]
                · Sinh viên: <b>@d["HoTen"]</b> (@d["MSSV"])
                · @(Convert.ToDateTime(d["NgayTao"]).ToString("HH:mm dd/MM/yyyy"))
            </div>
            <div class="don-content small">@d["NoiDung"]</div>
            @if (d["LoaiDon"].ToString() == "ChuyenPhong")
            {
                <hr class="my-3" />
                <div class="small">
                    <i class="bi bi-arrow-left-right me-1 text-dm"></i>
                    Chuyển từ phòng <b>@d["MaPhongCu"]</b> sang phòng <b>@d["MaPhongMoi"]</b>
                </div>
            }
            @if (d["TenNV"] != DBNull.Value)
            {
                <div class="small text-muted mt-3"><i class="bi bi-person-badge me-1"></i>Người phụ trách: @d["TenNV"]</div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        @if (loaiDon == "TraPhong" && trangThai != "DaXuLy" && trangThai != "TuChoi")
        {
            <div class="card p-4 mb-3 border-warning">
                <h3 class="h6 fw-bold mb-2"><i class="bi bi-box-arrow-left me-2 text-warning"></i>Xác nhận trả phòng</h3>
                <p class="small text-muted">Xác nhận sẽ giải phóng giường ngay lập tức và đóng đơn này thành "Đã xử lý". Hãy đối chiếu hiện trạng phòng trước khi xác nhận.</p>
                <form method="post" asp-action="XacNhanTraPhong"
                      data-confirm-title="Xác nhận trả phòng" data-confirm-level="success"
                      data-confirm-message="Xác nhận trả phòng? Giường sẽ được giải phóng ngay.">
                    <input type="hidden" name="maDon" value="@d["MaDon"]" />
                    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-check-lg me-1"></i>Xác nhận trả phòng</button>
                </form>
            </div>
        }
        @if (loaiDon == "ChuyenPhong" && trangThai != "DaXuLy" && trangThai != "TuChoi")
        {
            <div class="card p-4 mb-3 border-warning">
                <h3 class="h6 fw-bold mb-2"><i class="bi bi-arrow-left-right me-2 text-warning"></i>Xác nhận chuyển phòng</h3>
                <p class="small text-muted">
                    Xác nhận sẽ đóng hợp đồng ở phòng <b>@d["MaPhongCu"]</b>, mở hợp đồng mới ở phòng <b>@d["MaPhongMoi"]</b>
                    và cập nhật số giường trống của cả 2 phòng ngay lập tức.
                </p>
                <form method="post" asp-action="XacNhanChuyenPhong"
                      data-confirm-title="Xác nhận chuyển phòng" data-confirm-level="success"
                      data-confirm-message="Xác nhận chuyển sinh viên sang phòng @d["MaPhongMoi"]?">
                    <input type="hidden" name="maDon" value="@d["MaDon"]" />
                    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-check-lg me-1"></i>Xác nhận chuyển phòng</button>
                </form>
            </div>
        }
        @if (khoaVinhVien)
        {
            <div class="card p-4 border-success">
                <h3 class="h6 fw-bold mb-2 text-success"><i class="bi bi-check-circle-fill me-2"></i>Đơn đã hoàn tất</h3>
                <p class="small text-muted mb-2">
                    @(loaiDon == "TraPhong" ? "Yêu cầu trả phòng" : "Yêu cầu chuyển phòng") này đã được xác nhận và giường/hợp đồng đã được cập nhật thật sự trong hệ thống.
                    Vì vậy không thể đổi lại trạng thái hay mức ưu tiên của đơn nữa - việc này tránh gây nhầm lẫn (đơn bấm "xác nhận" lại trong khi sinh viên đã hoàn tất thủ tục).
                </p>
                @if (d["PhanHoi"] != DBNull.Value && !string.IsNullOrWhiteSpace(d["PhanHoi"].ToString()))
                {
                    <div class="don-content small mb-0">@d["PhanHoi"]</div>
                }
            </div>
        }
        else
        {
            <div class="card p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-gear me-2 text-dm"></i>Xử lý đơn (đổi ưu tiên / từ chối / phản hồi)</h3>
                <form method="post" asp-action="XuLyDon">
                    <input type="hidden" name="maDon" value="@d["MaDon"]" />
                    <div class="mb-3">
                        <label class="form-label small">Mức độ ưu tiên</label>
                        <select name="mucUuTien" class="form-select">
                            <option value="Cao" selected="@(d["MucUuTien"].ToString() == "Cao")">Cao</option>
                            <option value="TrungBinh" selected="@(d["MucUuTien"].ToString() == "TrungBinh")">Trung bình</option>
                            <option value="Thap" selected="@(d["MucUuTien"].ToString() == "Thap")">Thấp</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Trạng thái xử lý</label>
                        <select name="trangThai" class="form-select">
                            <option value="ChoXuLy" selected="@(trangThai == "ChoXuLy")">Chờ xử lý</option>
                            <option value="DangXuLy" selected="@(trangThai == "DangXuLy")">Đang xử lý</option>
                            @if (loaiDon != "TraPhong" && loaiDon != "ChuyenPhong")
                            {
                                <option value="DaXuLy" selected="@(trangThai == "DaXuLy")">Đã xử lý</option>
                            }
                            <option value="TuChoi" selected="@(trangThai == "TuChoi")">Từ chối</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Phản hồi / hướng giải quyết</label>
                        <textarea name="phanHoi" class="form-control" rows="4">@d["PhanHoi"]</textarea>
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="bi bi-bell me-1"></i>Sau khi lưu, hệ thống sẽ tự động gửi thông báo đến sinh viên.
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="DonYeuCau" class="btn btn-outline-secondary w-50">Trở về</a>
                        <button type="submit" class="btn btn-dm w-50">Lưu xử lý</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
