@using System.Data
@{
    ViewData["Title"] = "Đánh giá phòng/KTX";
    DataTable ds = ViewBag.DsThongKe;
    DataTable nx = ViewBag.DsNhanXet;
    DataTable toa = ViewBag.DsToa;
}

@* Thống kê đánh giá | View phức tạp -> style Inline (bảng đơn giản) *@
@section Styles {
    <style>
        .dgp-star {
            color: #f2a516;
        }

        .dgp-table thead th {
            font-size: .78rem;
            text-transform: uppercase;
            color: #7a8580;
            background: #fafbfa;
        }
    </style>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1">Tòa nhà</label>
                <select name="maToa" class="form-select" onchange="this.form.submit()">
                    <option value="">Tất cả</option>
                    @foreach (DataRow t in toa.Rows)
                    {
                        <option value="@t["MaToa"]" selected="@(ViewBag.MaToa?.ToString() == t["MaToa"].ToString())">@t["TenToa"]</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Điểm trung bình theo phòng</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dgp-table">
                    <thead><tr><th>Phòng</th><th>Tòa</th><th>Lượt đánh giá</th><th>Điểm TB</th></tr></thead>
                    <tbody>
                        @if (ds.Rows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đánh giá nào</td></tr>
                        }
                        @foreach (DataRow r in ds.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@r["MaPhong"]</td>
                                <td>@r["TenToa"]</td>
                                <td>@r["SoLuotDanhGia"]</td>
                                <td class="dgp-star"><i class="bi bi-star-fill me-1"></i>@(Convert.ToDecimal(r["DiemTrungBinh"]).ToString("0.0"))/5</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Nhận xét gần đây</div>
            <ul class="list-group list-group-flush" style="max-height:420px; overflow-y:auto;">
                @if (nx.Rows.Count == 0)
                {
                    <li class="list-group-item text-muted small">Chưa có nhận xét nào</li>
                }
                @foreach (DataRow r in nx.Rows)
                {
                    <li class="list-group-item small">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold">Phòng @r["MaPhong"] · @r["HoTen"]</span>
                            <span class="dgp-star"><i class="bi bi-star-fill me-1"></i>@r["SoSao"]/5</span>
                        </div>
                        @if (r["NhanXet"] != DBNull.Value)
                        {
                            <div class="text-muted">@r["NhanXet"]</div>
                        }
                        <div class="text-muted" style="font-size:.75rem">@(Convert.ToDateTime(r["NgayDanhGia"]).ToString("dd/MM/yyyy"))</div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
