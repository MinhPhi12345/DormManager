@using System.Data
@{
    ViewData["Title"] = "Danh sách đơn đăng ký ở KTX";
    DataTable ds = ViewBag.DsPhieu;
    var q = Context.Request.Query;
}

@* Danh sách + tra cứu đơn đăng ký | View phức tạp -> style External *@
@section Styles {
    <link rel="stylesheet" href="~/css/views/dondangky-ql.css" />
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
 <label class="form-label small mb-1">Tra cứu</label>
                <input type="text" name="tuKhoa" value="@q["tuKhoa"]" class="form-control" placeholder="MSSV, họ tên, mã phòng..." />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="ChoDoiChieu" selected="@(q["trangThai"] == "ChoDoiChieu")">Chờ đối chiếu</option>
                    <option value="DangO" selected="@(q["trangThai"] == "DangO")">Đang ở</option>
                    <option value="DaTraPhong" selected="@(q["trangThai"] == "DaTraPhong")">Đã trả phòng</option>
                    <option value="DaHuy" selected="@(q["trangThai"] == "DaHuy")">Đã hủy</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button class="btn btn-dm w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 ddk-table">
            <thead>
                <tr><th>Mã phiếu</th><th>Sinh viên</th><th>Phòng / Giường</th><th>Đợt</th><th>Ngày ĐK</th><th>Thời hạn</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @if (ds.Rows.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có đơn đăng ký nào</td></tr>
                }
                @foreach (DataRow r in ds.Rows)
                {
                    <tr class="@(r["TrangThai"].ToString() == "ChoDoiChieu" ? "row-pending" : "")">
                        <td class="fw-semibold">#@r["MaPhieu"]</td>
                        <td><div>@r["HoTen"]</div><div class="small text-muted">@r["MSSV"]</div></td>
                        <td>@r["MaPhong"]<div class="small text-muted">@r["MaGiuong"]</div></td>
                        <td class="small">@r["TenDot"]</td>
                        <td>@(Convert.ToDateTime(r["NgayDangKy"]).ToString("dd/MM/yyyy"))</td>
                        <td class="small">@(Convert.ToDateTime(r["NgayBatDau"]).ToString("dd/MM"))→@(Convert.ToDateTime(r["NgayKetThuc"]).ToString("dd/MM/yyyy"))</td>
                        <td>
                            @switch (r["TrangThai"].ToString())
                            {
                                case "ChoDoiChieu":
                                    <span class="badge text-bg-warning">Chờ đối chiếu</span>
                                    ; break;
                                case "DangO":

                                    <span class="badge text-bg-success">Đang ở</span>
                                    ; break;
                                case "DaTraPhong":

                                    <span class="badge text-bg-secondary">Đã trả phòng</span>
                                    ; break;
                                default:

                                    <span class="badge text-bg-danger">Đã hủy</span>
                                    ; break;
                            }
                        </td>
                        <td><a asp-action="ChiTietDangKy" asp-route-id="@r["MaPhieu"]" class="btn btn-sm btn-outline-success">Chi tiết</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
