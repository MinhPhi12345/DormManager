@using System.Data
@{
    ViewData["Title"] = "Danh sách giường - Phòng " + ViewBag.MaPhong;
    DataTable ds = ViewBag.DsGiuong;
}

@* Danh sách giường + cập nhật trạng thái | View đơn giản -> style Inline *@
@section Styles {
    <style>
        .giuong-card {
            border-left: 4px solid #ccc;
        }

            .giuong-card.st-Trong {
                border-left-color: #198754;
            }

            .giuong-card.st-DaSuDung {
                border-left-color: #0d6efd;
            }

            .giuong-card.st-BaoTri {
                border-left-color: #f2a516;
            }
    </style>
}

<a asp-action="Phong" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Danh sách phòng</a>

<div class="row g-3">
    @foreach (DataRow g in ds.Rows)
    {
        string tt = g["TrangThai"].ToString()!;
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card giuong-card st-@tt p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">@g["MaGiuong"]</span>
                    @switch (tt)
                    {
                        case "Trong":
                            <span class="badge text-bg-success">Trống</span>
                            ; break;
                        case "DaSuDung":

                            <span class="badge text-bg-primary">Đã sử dụng</span>
                            ; break;
                        default:

                            <span class="badge text-bg-warning">Bảo trì</span>
                            ; break;
                    }
                </div>
                @if (g["HoTen"] != DBNull.Value)
                {
                    <div class="small text-muted mb-2"><i class="bi bi-person me-1"></i>@g["HoTen"] (@g["MSSV"])</div>
                }
                else
                {
                    <form method="post" asp-action="CapNhatGiuong" class="d-flex gap-2">
                        <input type="hidden" name="maGiuong" value="@g["MaGiuong"]" />
                        <input type="hidden" name="maPhong" value="@ViewBag.MaPhong" />
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="Trong" selected="@(tt == "Trong")">Trống</option>
                            <option value="BaoTri" selected="@(tt == "BaoTri")">Bảo trì</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-dm">Lưu</button>
                    </form>
                }
            </div>
        </div>
    }
</div>
