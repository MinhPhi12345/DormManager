@{
    var vaiTro = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen") ?? Context.Session.GetString("TenDangNhap") ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string c, string a) => controller == c && action == a ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DormManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    @* Style riêng của từng view: Inline cho view đơn giản, External (file .css) cho view phức tạp *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">

        @* ===== SIDEBAR (desktop) + OFFCANVAS (mobile) ===== *@
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarMenu">
            <div class="offcanvas-header d-lg-none">
                <span class="sidebar-brand"><i class="bi bi-buildings-fill"></i> DormManager</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="sidebar-brand d-none d-lg-flex">
                    <i class="bi bi-buildings-fill"></i> DormManager
                </div>

                <nav class="sidebar-nav flex-grow-1">
                    @if (vaiTro == "SV")
                    {
                        <div class="nav-group-label">Sinh viên</div>
                        <a class="nav-item-link @Active("SinhVien", "TongQuan")" asp-controller="SinhVien" asp-action="TongQuan"><i class="bi bi-grid-1x2"></i> Tổng quan</a>
                        <a class="nav-item-link @Active("SinhVien", "TraCuuPhong")" asp-controller="SinhVien" asp-action="TraCuuPhong"><i class="bi bi-search"></i> Tra cứu phòng</a>
                        <a class="nav-item-link @Active("SinhVien", "HopDong")" asp-controller="SinhVien" asp-action="HopDong"><i class="bi bi-file-earmark-text"></i> Hợp đồng của tôi</a>
                        <a class="nav-item-link @Active("SinhVien", "HoaDon")" asp-controller="SinhVien" asp-action="HoaDon"><i class="bi bi-receipt"></i> Hóa đơn</a>
                        <a class="nav-item-link @(controller == "SinhVien" && (action == "DonYeuCau" || action == "TaoDon" || action == "ChiTietDon") ? "active" : "")" asp-controller="SinhVien" asp-action="DonYeuCau"><i class="bi bi-chat-left-dots"></i> Phản hồi &amp; đề xuất</a>
                    }
                    else if (vaiTro == "QL")
                    {
                        <div class="nav-group-label">Quản lý KTX</div>
                        <a class="nav-item-link @(controller == "QuanLy" && (action == "DonYeuCau" || action == "ChiTietDon") ? "active" : "")" asp-controller="QuanLy" asp-action="DonYeuCau"><i class="bi bi-inboxes"></i> Đơn phản hồi, yêu cầu</a>
                        <a class="nav-item-link @(controller == "QuanLy" && (action == "DonDangKy" || action == "ChiTietDangKy") ? "active" : "")" asp-controller="QuanLy" asp-action="DonDangKy"><i class="bi bi-clipboard-check"></i> Đơn đăng ký KTX</a>
                        <a class="nav-item-link @(controller == "QuanLy" && (action == "Phong" || action == "Giuong") ? "active" : "")" asp-controller="QuanLy" asp-action="Phong"><i class="bi bi-door-open"></i> Phòng &amp; giường</a>
                        <a class="nav-item-link @Active("QuanLy", "ChiSo")" asp-controller="QuanLy" asp-action="ChiSo"><i class="bi bi-speedometer2"></i> Chỉ số điện/nước</a>
                        <a class="nav-item-link @Active("QuanLy", "TaoHoaDon")" asp-controller="QuanLy" asp-action="TaoHoaDon"><i class="bi bi-receipt-cutoff"></i> Lập hóa đơn</a>
                        <a class="nav-item-link @Active("QuanLy", "LichSuThongBao")" asp-controller="QuanLy" asp-action="LichSuThongBao"><i class="bi bi-bell"></i> Lịch sử thông báo</a>
                        <a class="nav-item-link @Active("QuanLy", "ViPham")" asp-controller="QuanLy" asp-action="ViPham"><i class="bi bi-exclamation-triangle"></i> Sinh viên vi phạm</a>
                    }
                    else if (vaiTro == "QTV")
                    {
                        <div class="nav-group-label">Quản trị hệ thống</div>
                        <a class="nav-item-link @Active("QuanTri", "ThongKe")" asp-controller="QuanTri" asp-action="ThongKe"><i class="bi bi-bar-chart-line"></i> Thống kê tổng quan</a>
                        <a class="nav-item-link @Active("QuanTri", "Phong")" asp-controller="QuanTri" asp-action="Phong"><i class="bi bi-houses"></i> Quản lý phòng</a>
                        <a class="nav-item-link @Active("QuanTri", "HoaDon")" asp-controller="QuanTri" asp-action="HoaDon"><i class="bi bi-receipt"></i> Hóa đơn hệ thống</a>
                        <a class="nav-item-link @Active("QuanTri", "DonGia")" asp-controller="QuanTri" asp-action="DonGia"><i class="bi bi-lightning-charge"></i> Đơn giá điện/nước</a>
                        <a class="nav-item-link @Active("QuanTri", "DotDangKy")" asp-controller="QuanTri" asp-action="DotDangKy"><i class="bi bi-calendar-range"></i> Cổng đăng ký</a>
                        <a class="nav-item-link @Active("QuanTri", "TaiKhoan")" asp-controller="QuanTri" asp-action="TaiKhoan"><i class="bi bi-people"></i> Quản lý tài khoản</a>

                        <div class="nav-group-label mt-3">Nghiệp vụ quản lý</div>
                        <a class="nav-item-link @(controller == "QuanLy" && action == "DonYeuCau" ? "active" : "")" asp-controller="QuanLy" asp-action="DonYeuCau"><i class="bi bi-inboxes"></i> Đơn phản hồi, yêu cầu</a>
                        <a class="nav-item-link @(controller == "QuanLy" && action == "DonDangKy" ? "active" : "")" asp-controller="QuanLy" asp-action="DonDangKy"><i class="bi bi-clipboard-check"></i> Đơn đăng ký KTX</a>
                        <a class="nav-item-link @(controller == "QuanLy" && action == "ViPham" ? "active" : "")" asp-controller="QuanLy" asp-action="ViPham"><i class="bi bi-exclamation-triangle"></i> Sinh viên vi phạm</a>
                    }
                </nav>

                <div class="sidebar-footer">
                    <a asp-controller="TaiKhoan" asp-action="DangXuat" class="nav-item-link text-danger">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </aside>

        @* ===== NỘI DUNG CHÍNH ===== *@
        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-outline-secondary d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="topbar-title">@ViewData["Title"]</h1>
                <div class="topbar-user dropdown">
                    <button class="btn dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                        <span class="user-avatar"><i class="bi bi-person-fill"></i></span>
                        <span class="d-none d-sm-inline">@hoTen</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <span class="dropdown-item-text small text-muted">
                                Vai trò: @(vaiTro == "SV" ? "Sinh viên" : vaiTro == "QL" ? "Quản lý" : "Quản trị viên")
                            </span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </header>

            <main class="app-content">
                @if (vaiTro == "SV" && Context.Session.GetString("BiKhoa") == "1")
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                        <i class="bi bi-lock-fill mt-1"></i>
                        <div>
                            <strong>Tài khoản của bạn đang bị khóa một số tính năng</strong> do hóa đơn quá hạn thanh toán trên 7 ngày (theo quy định QD05).
                            Bạn tạm thời không thể <b>đăng ký ở KTX</b> và <b>gia hạn lưu trú</b> cho đến khi thanh toán hết nợ.
                            Vui lòng vào mục <a asp-controller="SinhVien" asp-action="HoaDon" class="alert-link">Hóa đơn</a> để thanh toán — tài khoản sẽ <b>tự động mở khóa ngay</b> sau khi thanh toán xong.
                        </div>
                    </div>
                }
                @if (TempData["ThanhCong"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Loi"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Loi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @* ===== Modal xác nhận dùng chung - thay thế hộp thoại confirm() mặc định của trình duyệt cho mọi thao tác nhạy cảm ===== *@
    <div class="modal fade" id="modalXacNhanChung" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content xn-modal">
                <div class="modal-body text-center pt-4 pb-2">
                    <div class="xn-icon-wrap" id="xnIconWrap"><i class="bi" id="xnIcon"></i></div>
                    <h5 class="xn-title" id="xnTitle"></h5>
                    <p class="xn-message text-muted mb-0" id="xnMessage"></p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4 pt-2">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn px-4" id="xnBtnXacNhan">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
